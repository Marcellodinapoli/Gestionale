# Credixa → Receiver auth (mirror Credixa RECEIVER_AUTH_MODE / secrets)
# Multi-azienda: una voce per ogni tenantId Credixa
RECEIVER_AUTH_MODE=api_key
# JSON map: { "<tenantId>": "<secret>" }
RECEIVER_SECRETS_JSON={"TENANT-TEST":"test-receiver-secret"}

# SOURCE → Receiver auth (Indeed / CreditCore) — secret DISTINTI, per tenant
RECEIVER_SOURCE_AUTH_MODE=api_key
RECEIVER_SOURCE_SECRETS_JSON={"TENANT-TEST":"test-source-secret"}
# NON impostare RECEIVER_SOURCE_KEY in multi-azienda (deprecato)

# Max CV upload size (bytes)
MAX_CV_SIZE_BYTES=5242880

# Local DocumentStorage root (never exposed via API)
RECEIVER_STORAGE_ROOT=./data/storage

# Temporary CV open URL base (must be reachable by Credixa browser session in real deploy)
RECEIVER_PUBLIC_BASE_URL=http://127.0.0.1:3040

# Push istantaneo candidature → Credixa (dopo ogni ingest/update SOURCE)
CREDIXA_PUSH_URL=http://127.0.0.1:3001/api/recruiting/receiver-push

# HMAC secret for temporary open tokens (independent from Credixa auth secret)
RECEIVER_TMP_SIGNING_SECRET=dev-tmp-signing-secret

PORT=3040
