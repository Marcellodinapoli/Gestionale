{
  "name": "credixa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate --schema src/lib/firebase/schema.prisma && next build --webpack",
    "start": "next start --port 3001",
    "lint": "eslint",
    "db:seed": "node scripts/reset-firebase-minimal.mjs",
    "db:reset": "node scripts/reset-firebase-minimal.mjs",
    "db:seed:demo": "tsx scripts/seed-firebase.ts",
    "postinstall": "prisma generate --schema src/lib/firebase/schema.prisma",
    "build:netlify": "prisma generate --schema src/lib/firebase/schema.prisma && next build --webpack",
    "firebase:verify": "node scripts/verify-firebase.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.18.0",
