SESSION_SECRET="cambia-questa-chiave-in-produzione-32ch"

# Backend dati operativo: neon (cloud, come Netlify) | connector | firestore (legacy)
DATABASE_PROVIDER="neon"
# Prisma generate / tipi — NON è Neon
DATABASE_URL="file:./src/lib/firebase/.types-only.db"

# Neon (Postgres cloud) — dati operativi. Formazione resta su Firebase.
# Console: progetto Credixa-Test → Connection details → copia stringa (pooled).
# NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Dopo averla impostata: npm run neon:ping

CONNECTOR_BASE_URL="http://localhost:8443"
# CONNECTOR_API_KEY=""
# Opzionale: mappa tenant → Connettore (cambio URL senza nuovo pairing)
# CONNECTOR_URLS_JSON={"demo":"http://localhost:8443"}
# CONNECTOR_KEYS_JSON={"demo":"secret"}

# Recruiting — secret Credixa→Receiver aziendale (per tenant / azienda). Solo server-side.
# Ogni azienda Credixa deve avere la propria voce (stesso tenantId usato in gestionale).
# RECEIVER_SECRETS_JSON={"<tenantIdA>":"<secretA>","<tenantIdB>":"<secretB>"}
# RECEIVER_AUTH_MODE=api_key
# Secret SOURCE per push istantaneo Receiver → Credixa (stesso JSON del receiver, per tenant)
# RECEIVER_SOURCE_SECRETS_JSON={"<tenantIdA>":"<sourceSecretA>","<tenantIdB>":"<sourceSecretB>"}
#   api_key → header X-Receiver-Key (Credixa→Receiver) / X-Receiver-Source-Key (SOURCE→Credixa)
#   bearer  → Authorization: Bearer …
#   hmac    → X-Receiver-Timestamp + X-Receiver-Signature (HMAC-SHA256)
# NON usare RECEIVER_SOURCE_KEY globale in multi-azienda (deprecato; solo legacy single-tenant).

# URL pubblico BFF usato da CreditCalc (pairing / pratiche). Non serve “pubblicare”
# se telefono e PC sono sulla stessa Wi‑Fi: il QR deve contenere un host raggiungibile
# (IP LAN o dominio). In prod: CREDIXA_BFF_PUBLIC_URL = URL del sito (es. Netlify).
# Dev: imposta esplicitamente OPPURE lascia che il server sostituisca localhost con
# l’IP LAN rilevato; in caso ambiguo usa CREDIXA_BFF_LAN_HOST o CREDIXA_BFF_PUBLIC_URL.
# CREDIXA_BFF_PUBLIC_URL="http://192.168.1.5:3100"
# CREDIXA_BFF_LAN_HOST="192.168.1.5"
# NEXT_PUBLIC_CREDIXA_BFF_URL="https://tuo-gestionale.netlify.app"

# Assistenza chatbot — verifica ruolo su Neon per Cloud Function gestionaleHelp (solo server).
# Gestionale: ASSISTENZA_ROLE_VERIFY_SECRET in .env (non committare).
# Functions emulator (repo credit-calc-store): stesso secret in functions/.env.creditform-d505d
#   + GESTIONALE_ASSISTENZA_VERIFY_BASE_URL=http://127.0.0.1:3001 (HTTP solo su localhost/127.0.0.1).
# ASSISTENZA_ROLE_VERIFY_SECRET="genera-stringa-lunga-random-dev"

# Recruiting — link pubbliche offerte
# Landing CreditCore (elenco offerte): https://creditplanet.netlify.app/?job={docId}
# NEXT_PUBLIC_CREDITCORE_PUBLIC_URL="https://creditplanet.netlify.app"
# Indeed — lascia vuoto finché non attivo; template con {id} = indeedJobId
# NEXT_PUBLIC_INDEED_JOB_URL_TEMPLATE="https://it.indeed.com/viewjob?jk={id}"

# Platform — inviti ADMIN (link + email)
# CREDIXA_PUBLIC_URL="https://credixa-app.netlify.app"
# PLATFORM_API_KEY="…"
# RESEND_API_KEY="re_…"
# EMAIL_FROM="Credixa <onboarding@tuodominio.it>"

# Legacy — sostituito da DATABASE_PROVIDER (mantenuto per compatibilità)
OPERATIONAL_BACKEND="firebase"

# Firebase — obbligatorio per Formazione (permanente) e fallback operativo attuale
# Dopo rigenerazione chiave in Console: sostituisci il file e riavvia `npm run dev`. Verifica: npm run check:firebase
# FIREBASE_SERVICE_ACCOUNT_JSON={...intero service account...}
# oppure:
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="creditform-d505d.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="creditform-d505d"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="creditform-d505d.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="418457726672"
NEXT_PUBLIC_FIREBASE_APP_ID="1:418457726672:web:4d0d18604a93fbdd93f8d5"

# SQL Server on-premise: solo via Connettore (non esporre DATABASE_URL SQL in Credixa).
# Neon: usare NEON_DATABASE_URL (sopra), separato da SQL locale.
